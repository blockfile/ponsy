# Copy to `.env` and fill in. Only TOKEN_ADDRESS is required to go live.

# -----------------------------------------------------------------------------
# THE ONE THING YOU MUST SET AT LAUNCH
# -----------------------------------------------------------------------------
# The $PONSY ERC-20 contract on Robinhood Chain.
# Leave unset and /stats returns nulls, so the site shows dashes rather than
# advertising a token that isn't yours. Nothing else here needs to change.
TOKEN_ADDRESS=

# The Uniswap v3 PONSY/WETH pool, for on-chain pricing.
# Leave this unset. It only prices a Uniswap v3 WETH pair, and the live PONSY
# pool is Uniswap v4 — this reader cannot price a v4 pool. Setting it anyway
# does not enable on-chain pricing (Dexscreener is the correct, working
# fallback with POOL_ADDRESS unset); it only adds a second, sequential RPC
# call inside readChain with a ~16s worst case, past nginx's 15s
# proxy_read_timeout — the direct cause of a prior production 504 outage. Only
# set this once the pool it points at is confirmed to be a Uniswap v3 WETH
# pair.
POOL_ADDRESS=

# -----------------------------------------------------------------------------
# UPSTREAMS — the defaults are correct for Robinhood Chain (id 4663)
# -----------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_URL=https://api.dexscreener.com

# WETH on Robinhood Chain. On-chain pricing multiplies by the native coin price,
# so it is only valid against a WETH pair. If POOL_ADDRESS turns out to pair
# PONSY with something else, the backend refuses to price it on-chain and falls
# back to Dexscreener rather than reporting a number that is wrong by ~1900x.
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8787

# Interface to bind. Loopback by default: behind nginx there is no reason to
# accept traffic on the public interface. Set 0.0.0.0 only inside a container
# that is itself the network boundary.
HOST=127.0.0.1

# Comma-separated origins allowed to call /stats. The frontend calls this
# cross-origin, so its URL must appear here.
# In production that is the Netlify site: https://ponsy.fun
# Use * to allow any origin (fine for public read-only data).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# TUNING — sensible defaults, rarely worth changing
# -----------------------------------------------------------------------------
# How long a fetched payload is served before refetching. The frontend polls
# every 60s, so upstreams are hit at most once a cycle no matter the traffic.
CACHE_TTL_MS=30000

# How long the last good payload keeps being served while upstreams are failing.
# Past this, /stats returns 503 and the panel shows its RETRY state.
STALE_MAX_MS=600000

# Per-request timeout for any single upstream call.
UPSTREAM_TIMEOUT_MS=8000

# How often the background refresher re-collects stats and writes them into
# the cache, so GET /stats normally answers from memory instead of waiting on
# an upstream. Keep this below CACHE_TTL_MS so the timer stays ahead of
# expiry — the default (20s refresh vs 30s TTL) gives a 10s margin.
REFRESH_INTERVAL_MS=20000

# How long GET /stats will wait on a cold cache (nothing collected yet, eg.
# right after a restart) before answering 503 instead of hanging. Kept well
# under both the ~8s worst-case collection time and nginx's 15s
# proxy_read_timeout, so a slow first request degrades honestly rather than
# ever reaching nginx's timeout.
STATS_WAIT_MS=5000

# Relay intent API. The default is correct.
RELAY_URL=https://api.relay.link

# Chains a visitor may pay from: Base, Ethereum, Arbitrum, Optimism, Robinhood, BNB Chain.
ALLOWED_CHAIN_IDS=8453,1,42161,10,4663,56

# Minimum trade in USD. Below this, fixed costs exceed 5% of the trade.
MIN_TRADE_USD=25
